{
  "permissions": {
    "allow": [
      "Bash(scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(uv *)",
      "Bash(cargo test*)",
      "Bash(go test*)",
      "Bash(rg *)",
      "Bash(file *)",
      "Bash(strings *)",
      "Bash(xxd *)",
      "Bash(objdump *)",
      "Bash(readelf *)"
    ],
    "deny": [
      "Edit(/vendor/**)",
      "Read(**/.env)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
